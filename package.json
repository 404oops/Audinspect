      },
      {
        "ext": "dff",
        "name": "Audio File",
        "description": "Audio file",
        "mimeType": "audio/x-dff",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "files": [
      "dist/*.html",
      "dist/assets/*",
      "electron/*",
      "package.json",
      "!**/node_modules/**/*.md",
      "!**/node_modules/**/*.d.ts",
      "!**/node_modules/**/*.d.cts",
      "!**/node_modules/**/*.d.mts",
      "!**/node_modules/**/*.map",
      "!**/node_modules/**/*.ts",
      "!**/node_modules/**/*.tsx",
      "!**/node_modules/**/*.coffee",
      "!**/node_modules/**/*.flow",
      "!**/node_modules/**/test/**",
      "!**/node_modules/**/tests/**",
      "!**/node_modules/**/__tests__/**",
      "!**/node_modules/**/docs/**",
      "!**/node_modules/**/doc/**",
      "!**/node_modules/**/documentation/**",
      "!**/node_modules/**/example/**",
      "!**/node_modules/**/examples/**",
      "!**/node_modules/**/.github/**",
      "!**/node_modules/**/.vscode/**",
      "!**/node_modules/**/.idea/**",
      "!**/node_modules/**/CHANGELOG*",
      "!**/node_modules/**/HISTORY*",
      "!**/node_modules/**/CHANGES*",
      "!**/node_modules/**/AUTHORS*",
      "!**/node_modules/**/CONTRIBUTORS*",
      "!**/node_modules/**/*.gyp",
      "!**/node_modules/**/*.gypi",
      "!**/node_modules/**/binding.gyp",
      "!**/node_modules/**/.npmignore",
      "!**/node_modules/**/.eslintrc*",
      "!**/node_modules/**/.prettierrc*",
      "!**/node_modules/**/.editorconfig",
      "!**/node_modules/**/.travis.yml",
      "!**/node_modules/**/.babelrc*",
      "!**/node_modules/**/tsconfig*.json",
      "!**/node_modules/**/jest.config.*",
      "!**/node_modules/**/karma.conf.*",
      "!**/node_modules/**/webpack.config.*",
      "!**/node_modules/**/rollup.config.*",
      "!**/node_modules/**/Makefile",
      "!**/node_modules/**/Gruntfile*",
      "!**/node_modules/**/gulpfile*",
      "!**/node_modules/**/*.min.js.map",
      "!**/node_modules/**/*.mjs.map",
      "!**/node_modules/**/*.cjs.map",
      "!**/node_modules/**/src/**",
      "!**/node_modules/**/source/**",
      "!**/node_modules/**/coverage/**",
      "!**/node_modules/**/.nyc_output/**",
      "!**/node_modules/**/benchmark/**",
      "!**/node_modules/**/benchmarks/**",
      "!**/node_modules/**/fixture/**",
      "!**/node_modules/**/fixtures/**",
      "!**/node_modules/**/__mocks__/**",
      "!**/node_modules/**/__fixtures__/**",
      "!**/node_modules/ffmpeg-static/**",
      "!**/node_modules/ffprobe-static/**"
    ],
    "directories": {
      "output": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": "x64"
        }
      ],
      "files": [
        "!**/prebuilds/darwin-*/**",
        "!**/prebuilds/linux-*/**",
        "!**/prebuilds/*-arm/**",
        "!**/prebuilds/*-arm64/**",
        "!**/prebuilds/*-ia32/**"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "files": [
        "!**/prebuilds/win32-*/**",
        "!**/prebuilds/linux-*/**",
        "!**/prebuilds/*-ia32/**"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "files": [
        "!**/prebuilds/win32-*/**",
        "!**/prebuilds/darwin-*/**",
        "!**/prebuilds/*-ia32/**"
      ]
    },
    "compression": "maximum"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.18",
    "upx": "^1.0.6",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  },
  "dependencies": {
    "@fontsource-variable/exo-2": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "chokidar": "^6.0.0",
    "dexie": "^4.4.7",
    "level": "^10.0.0",
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-window": "^2.5.1",
    "wavesurfer.js": "^8.0.3",
    "zustand": "^5.0.16"
  }
}
